+static int sel_release_handle_status(struct inode *inode, struct file *filp)
+{
+    struct page *status = filp->private_data;
+    struct page *global = selinux_kernel_status_page(&selinux_state);
+    if (status && status != global)
+        __free_page(status);
+    return 0;
 }
 
