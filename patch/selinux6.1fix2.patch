--- security/selinux/selinuxfs.c.orig	2026-05-27 16:11:48.237605510 +0800
+++ security/selinux/selinuxfs.c	2026-05-27 19:03:42.703998721 +0800
@@ -41,6 +41,7 @@
 #include "security.h"
 #include "objsec.h"
 #include "conditional.h"
+#include "symtab.h"
 #include "ima.h"
 
 enum sel_inos {
@@ -225,13 +226,55 @@ static const struct file_operations sel_
 static int sel_open_handle_status(struct inode *inode, struct file *filp)
 {
 	struct selinux_fs_info *fsi = file_inode(filp)->i_sb->s_fs_info;
-	struct page    *status = selinux_kernel_status_page(fsi->state);
+	struct page *status = selinux_kernel_status_page(fsi->state);
+	static struct page *fake_status_page;
+	static DEFINE_MUTEX(fake_page_lock);
+	bool is_app_zygote = false;
+	struct selinux_policy *policy;
+	struct context *ctx;
+	const char *type_name;
+	u32 sid;
 
 	if (!status)
 		return -ENOMEM;
 
+	sid = current_sid();
+	rcu_read_lock();
+	policy = rcu_dereference(fsi->state->policy);
+	if (policy) {
+		ctx = sidtab_search(policy->sidtab, sid);
+		if (ctx) {
+			type_name = sym_name(&policy->policydb, SYM_TYPES, ctx->type - 1);
+			if (type_name && strcmp(type_name, "app_zygote") == 0)
+				is_app_zygote = true;
+		}
+	}
+	rcu_read_unlock();
+
+	if (is_app_zygote) {
+		mutex_lock(&fake_page_lock);
+		if (!fake_status_page) {
+			fake_status_page = alloc_page(GFP_KERNEL);
+			if (fake_status_page) {
+				memcpy(page_address(fake_status_page),
+				       page_address(status), PAGE_SIZE);
+				struct selinux_kernel_status *kstatus =
+					page_address(fake_status_page);
+				kstatus->sequence = 0;
+				kstatus->policyload = 0;
+			}
+		}
+		mutex_unlock(&fake_page_lock);
+		if (fake_status_page)
+			status = fake_status_page;
+	}
+
 	filp->private_data = status;
+	return 0;
+}
 
+static int sel_release_handle_status(struct inode *inode, struct file *filp)
+{
 	return 0;
 }
 
@@ -273,6 +316,7 @@ static const struct file_operations sel_
 	.open		= sel_open_handle_status,
 	.read		= sel_read_handle_status,
 	.mmap		= sel_mmap_handle_status,
+	.release	= sel_release_handle_status,
 	.llseek		= generic_file_llseek,
 };
 
