+/*
+ * Zero-width / invisible Unicode character filter for FUSE paths.
+ * These characters can be used to bypass path-based access controls
+ * (e.g. /Android/\u200ddata vs /Android/data).
+ */
+static const unsigned char fuse_invisible_seqs[][3] = {
+	{0xE2, 0x80, 0x8B},  /* U+200B ZERO WIDTH SPACE */
+	{0xE2, 0x80, 0x8C},  /* U+200C ZERO WIDTH NON-JOINER */
+	{0xE2, 0x80, 0x8D},  /* U+200D ZERO WIDTH JOINER */
+	{0xE2, 0x80, 0x8E},  /* U+200E LEFT-TO-RIGHT MARK */
+	{0xE2, 0x80, 0x8F},  /* U+200F RIGHT-TO-LEFT MARK */
+	{0xE2, 0x80, 0xAA},  /* U+202A LRE */
+	{0xE2, 0x80, 0xAB},  /* U+202B RLE */
+	{0xE2, 0x80, 0xAC},  /* U+202C PDF */
+	{0xE2, 0x80, 0xAD},  /* U+202D LRO */
+	{0xE2, 0x80, 0xAE},  /* U+202E RLO */
+	{0xE2, 0x81, 0xA0},  /* U+2060 WORD JOINER */
+	{0xE2, 0x81, 0xA1},  /* U+2061 FUNCTION APPLICATION */
+	{0xE2, 0x81, 0xA2},  /* U+2062 INVISIBLE TIMES */
+	{0xE2, 0x81, 0xA3},  /* U+2063 INVISIBLE SEPARATOR */
+	{0xE2, 0x81, 0xA4},  /* U+2064 INVISIBLE PLUS */
+	{0xEF, 0xBB, 0xBF},  /* U+FEFF BOM */
+	{0xE2, 0x80, 0x8A},  /* U+200A HAIR SPACE */
+	{0xE2, 0x80, 0x88},  /* U+2008 PUNCTUATION SPACE */
+};
+
+static int fuse_arg_has_invisible(const struct fuse_arg *arg)
+{
+	const unsigned char *p;
+	size_t remain;
+	int i, skip;
+
+	if (!arg || !arg->value)
+		return 0;
+
+	p = arg->value;
+	remain = arg->size;
 
+	/*
+	 * Fast path: pure ASCII bytes (< 0x80) can never encode
+	 * zero-width / invisible Unicode codepoints — skip them.
+	 */
+	while (remain > 0 && (*p & 0x80) == 0) {
+		p++;
+		remain--;
+	}
+	if (remain == 0)
+		return 0;
+
+	/* Slow path: scan multi-byte UTF-8 codepoints */
+	while (remain > 0) {
+		if (remain >= 2 && p[0] == 0xC2 && p[1] == 0xAD)
+			return 1;
+		for (i = 0; i < ARRAY_SIZE(fuse_invisible_seqs); i++) {
+			if (remain >= 3 &&
+			    p[0] == fuse_invisible_seqs[i][0] &&
+			    p[1] == fuse_invisible_seqs[i][1] &&
+			    p[2] == fuse_invisible_seqs[i][2])
+				return 1;
+		}
+		if ((*p & 0x80) == 0)
+			skip = 1;
+		else if ((*p & 0xE0) == 0xC0)
+			skip = 2;
+		else if ((*p & 0xF0) == 0xE0)
+			skip = 3;
+		else if ((*p & 0xF8) == 0xF0)
+			skip = 4;
+		else
+			skip = 1;
+		if (skip > remain)
+			break;
+		p += skip;
+		remain -= skip;
+	}
+	return 0;
+}
 /* Ordinary requests have even IDs, while interrupts IDs are odd */
 #define FUSE_INT_REQ_BIT (1ULL << 0)
 #define FUSE_REQ_ID_STEP (1ULL << 1)
@@ -1282,7 +1358,28 @@
