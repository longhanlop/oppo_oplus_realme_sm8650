+/*
+ * Reject FUSE requests whose arguments contain zero-width
+ * or invisible Unicode characters before copying to userspace.
+ */
+{
+	unsigned int _i;
+	for (_i = 0; _i < req->args->in_numargs; _i++) {
+		/*
+		 * Skip the last in_arg when it is a page buffer:
+		 * its ->value may be NULL / undefined and it is
+		 * only ever used for file payload data (WRITE etc),
+		 * never for pathnames — so no bypass risk.
+		 */
+		if (req->args->in_pages && _i == req->args->in_numargs - 1)
+			continue;
+		if (fuse_arg_has_invisible(
+		    (const struct fuse_arg *)&req->args->in_args[_i])) {
+			req->out.h.error = -EACCES;
+			goto invisible_reject;
+		}
+	}
+}
 	args = req->args;
 	reqsize = req->in.h.len;
 
@@ -1350,6 +1447,14 @@
  err_unlock:
 	spin_unlock(&fiq->lock);
 	return err;
+	invisible_reject:
+	pr_warn_ratelimited(
+	"fuse: blocked request opcode=%u from pid=%d uid=%u: "
+	"arguments contain invisible Unicode characters\n",
+	req->args->opcode, req->in.h.pid, req->in.h.uid);
+	req->out.h.error = -EACCES;
+	fuse_request_end(req);
+	goto restart;
 }
 
