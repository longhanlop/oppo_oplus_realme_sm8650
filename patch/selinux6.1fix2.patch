--- security/selinux/selinuxfs.c.orig	2026-05-27 16:11:48.237605510 +0800
+++ security/selinux/selinuxfs.c	2026-05-28 07:47:10.964999505 +0800
@@ -225,16 +225,49 @@ static const struct file_operations sel_
 static int sel_open_handle_status(struct inode *inode, struct file *filp)
 {
 	struct selinux_fs_info *fsi = file_inode(filp)->i_sb->s_fs_info;
-	struct page    *status = selinux_kernel_status_page(fsi->state);
+	struct page *status = selinux_kernel_status_page(fsi->state);
+	static struct page *fake_status_page;
+	static DEFINE_MUTEX(fake_page_lock);
+	bool is_app_zygote = false;
+	char *scontext = NULL;
+	u32 sid, len;
 
 	if (!status)
 		return -ENOMEM;
 
-	filp->private_data = status;
+	sid = current_sid();
+    if (security_sid_to_context(fsi->state, sid, &scontext, &len) == 0) {
+           if (strncmp(scontext, "u:r:app_zygote:", 15) == 0)
+               is_app_zygote = true;
+            security_release_secctx(scontext, len);
+    }
+
+	if (is_app_zygote) {
+		mutex_lock(&fake_page_lock);
+		if (!fake_status_page) {
+			fake_status_page = alloc_page(GFP_KERNEL);
+			if (fake_status_page) {
+				memcpy(page_address(fake_status_page),
+				       page_address(status), PAGE_SIZE);
+				struct selinux_kernel_status *kstatus =
+					page_address(fake_status_page);
+				kstatus->sequence = 0;
+				kstatus->policyload = 0;
+			}
+		}
+		mutex_unlock(&fake_page_lock);
+		if (fake_status_page)
+			status = fake_status_page;
+	}
 
+	filp->private_data = status;
+	return 0;
+}
+static int sel_release_handle_status(struct inode *inode, struct file *filp)
+{
+	/* 共享页面不释放，避免 UAF */
 	return 0;
 }
-
 static ssize_t sel_read_handle_status(struct file *filp, char __user *buf,
